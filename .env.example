# ---------------------------------------------------------------------------
# On Radar — environment configuration
#
# Copy to .env and fill in. Only DATABASE_URL and SESSION_SECRET are required;
# every integration below degrades to a documented mock so the app, the test
# suite and demo mode all run with no third-party credentials.
#
# Never commit .env. The app validates this file at startup and fails with a
# precise message rather than misbehaving later.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# Any Postgres 14+: Supabase, Neon, RDS, or local.
#
# For a local demo with nothing to install, use the embedded engine instead:
#   DATABASE_URL=pglite://./data/onradar
# `npm run setup` writes that for you. It is single-process, so it cannot be
# shared with a separate worker — set DEMO_MODE=true and the app ticks itself.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onradar
# Set to true for hosted Postgres that requires TLS (Supabase, Neon, RDS).
DATABASE_SSL=false

# Signs session tokens. At least 32 characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# Public origin. Used for webhook callback URLs and provider signature checks,
# so it must match the URL your provider actually posts to.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- SMS --------------------------------------------------------------------
# mock | twilio | telnyx. A provider selected but missing credentials falls back
# to mock, and Settings → Integrations shows which is actually live.
SMS_PROVIDER=mock

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional: use a Messaging Service instead of a single number.
TWILIO_MESSAGING_SERVICE_SID=

TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
# Base64 Ed25519 key from the Telnyx portal. Without it, webhooks are rejected.
TELNYX_PUBLIC_KEY=

# --- AI ---------------------------------------------------------------------
# mock | anthropic
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# Two tiers: the fast model classifies and extracts, the strong model handles
# live sales turns, objections and research.
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_SMART=claude-sonnet-5

# --- Lead discovery ---------------------------------------------------------
# mock | google_places. `mock` generates synthetic businesses with phone numbers
# in the 555-01xx range reserved for fiction and .example domains, so nothing
# real is ever contacted. A provider selected but missing a key falls back to
# mock, and the lead-generation page says which one is actually running.
LEAD_DISCOVERY_PROVIDER=mock

# Google Places API (New). Enable "Places API (New)" on the key's project.
# Every search costs money: the adapter sends a field mask for the cheapest SKU
# that still returns what the pipeline needs.
GOOGLE_PLACES_API_KEY=

# Hard ceiling on provider requests per search job, so one search cannot run up
# an unbounded bill. Each request returns up to 20 places.
LEAD_DISCOVERY_MAX_REQUESTS=10

# --- Website enrichment -----------------------------------------------------
# The crawler fetches a small, fixed set of paths per site, honours robots.txt,
# and is sequential per domain. Treat every page it returns as untrusted input.
CRAWL_CONCURRENCY=4
CRAWL_TIMEOUT_MS=10000
CRAWL_MAX_PAGES=6
# Identify yourself honestly, with a URL a site owner can use to reach you.
CRAWL_USER_AGENT=OnRadarBot/1.0 (+https://onradar.example/bot)

# --- Calling ----------------------------------------------------------------
# Only `device` ships today: the app builds a tel: URI and the operator's phone
# places the call. It follows that the app knows a call was STARTED and nothing
# more — no ring, no answer, no duration — so every other outcome is recorded
# as the operator's report and analytics labels it that way. Adding a voice
# provider is what makes connect rate a measured number.
CALL_PROVIDER=device

# --- Calendar ---------------------------------------------------------------
# internal | google. Appointments are always stored in On Radar; Google mirrors
# them outward and factors real free/busy into proposed slots.
CALENDAR_PROVIDER=internal
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Operations -------------------------------------------------------------

# Bearer token for POST /api/worker/tick. Without it the endpoint is refused
# outright rather than left open. Only needed if you drive the worker over HTTP
# instead of running `npm run worker`.
WORKER_TOKEN=

# Runs the worker inside the app instead of as a separate process. Local demo
# only — a real deployment runs `npm run worker` (or the cron) instead.
DEMO_MODE=false

# debug | info | warn | error
LOG_LEVEL=info

# Interval for the long-lived worker process, in milliseconds.
WORKER_INTERVAL_MS=5000
