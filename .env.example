# ---------------------------------------------------------------------------
# On Radar — environment configuration
#
# Copy to .env and fill in. Only DATABASE_URL and SESSION_SECRET are required;
# every integration below degrades to a documented mock so the app, the test
# suite and demo mode all run with no third-party credentials.
#
# Never commit .env. The app validates this file at startup and fails with a
# precise message rather than misbehaving later.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# Any Postgres 14+: Supabase, Neon, RDS, or local.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onradar
# Set to true for hosted Postgres that requires TLS (Supabase, Neon, RDS).
DATABASE_SSL=false

# Signs session tokens. At least 32 characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# Public origin. Used for webhook callback URLs and provider signature checks,
# so it must match the URL your provider actually posts to.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- SMS --------------------------------------------------------------------
# mock | twilio | telnyx. A provider selected but missing credentials falls back
# to mock, and Settings → Integrations shows which is actually live.
SMS_PROVIDER=mock

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional: use a Messaging Service instead of a single number.
TWILIO_MESSAGING_SERVICE_SID=

TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
# Base64 Ed25519 key from the Telnyx portal. Without it, webhooks are rejected.
TELNYX_PUBLIC_KEY=

# --- AI ---------------------------------------------------------------------
# mock | anthropic
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# Two tiers: the fast model classifies and extracts, the strong model handles
# live sales turns, objections and research.
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_SMART=claude-sonnet-5

# --- Calendar ---------------------------------------------------------------
# internal | google. Appointments are always stored in On Radar; Google mirrors
# them outward and factors real free/busy into proposed slots.
CALENDAR_PROVIDER=internal
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Operations -------------------------------------------------------------

# Bearer token for POST /api/worker/tick. Without it the endpoint is refused
# outright rather than left open. Only needed if you drive the worker over HTTP
# instead of running `npm run worker`.
WORKER_TOKEN=

# debug | info | warn | error
LOG_LEVEL=info

# Interval for the long-lived worker process, in milliseconds.
WORKER_INTERVAL_MS=5000
